# Copia este archivo a .env (está en .gitignore) y completa los valores.
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
PORT=3001
NODE_ENV=development
RESET_TOKEN_TTL_MINUTES=15

# Sesión
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# SSO con Google (Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth, tipo "Aplicación web")
# URI de redireccionamiento autorizado: debe ser EXACTAMENTE GOOGLE_REDIRECT_URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
FRONTEND_URL=http://localhost:3001
