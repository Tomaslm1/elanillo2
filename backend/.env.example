# Copia este archivo a .env (está en .gitignore) y completa los valores.

# Base de datos (docker compose up -d db levanta Postgres en el puerto 5433)
DATABASE_URL=postgresql://ideator:ideator@localhost:5433/ideator?schema=public
# Opcional: base usada por npm test (por defecto ideator_test en el mismo servidor)
# DATABASE_URL_TEST=postgresql://ideator:ideator@localhost:5433/ideator_test?schema=public

# Seguridad (obligatorio en producción)
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
# Orígenes permitidos para CORS con cookies (separados por coma). Por defecto, FRONTEND_URL.
# CORS_ORIGINS=http://localhost:3001

# Sesión
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
RESET_TOKEN_TTL_MINUTES=15

# IA principal: Claude en Microsoft Foundry
LLM_PROVIDER=anthropic                       # anthropic | azure-openai (el otro queda de respaldo)
ANTHROPIC_FOUNDRY_RESOURCE=<recurso>          # https://<recurso>.services.ai.azure.com/anthropic/
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5               # nombre del deployment en Foundry
LLM_EFFORT=medium                             # low | medium | high | xhigh | max
LLM_MAX_TOKENS=64000

# IA de respaldo (Azure OpenAI, endpoint compatible /openai/v1)
AZURE_OPENAI_BASE_URL=https://<recurso>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=model-router
LLM_TIMEOUT_MS=600000

# Logs: debug | info | warn | error | silent
LOG_LEVEL=info

# SSO con Google (Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth, tipo "Aplicación web")
# URI de redireccionamiento autorizado: debe ser EXACTAMENTE GOOGLE_REDIRECT_URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
